{
  "manifest_version": 3,
  "name": "Ghost Typer",
  "version": "2.0",
  "description": "Learning assistant",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Toggle panel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
